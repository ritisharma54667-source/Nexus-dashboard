# ─────────────────────────────────────────────────────────────
# Nexus Dashboard — Server environment variables
# Copy this file to .env and fill in real values before running.
# ─────────────────────────────────────────────────────────────

# Server
PORT=4000
NODE_ENV=development

# Postgres connection string
# Local example:   postgresql://postgres:postgres@localhost:5432/nexus_dashboard
# Neon/hosted example: postgresql://user:pass@ep-xxxx.neon.tech/nexus_dashboard?sslmode=require
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/nexus_dashboard

# JWT secrets — use long random strings in production.
# Generate one quickly with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=replace_with_a_long_random_string_access
JWT_REFRESH_SECRET=replace_with_a_long_random_string_refresh

# Token lifetimes
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=7d
REFRESH_TOKEN_TTL_MS=604800000

# CORS — the origin your Vite frontend runs on
CLIENT_ORIGIN=http://localhost:5173

# ── Email (forgot password) ──────────────────────────────────
# If left blank, reset emails are printed to the server console instead
# of actually being sent — handy for local dev with no SMTP account.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Nexus Dashboard <no-reply@nexus.io>"

# Base URL of the frontend, used to build the reset-password link
CLIENT_APP_URL=http://localhost:5173
